# Salin menjadi pipeline/.env (cp pipeline/.env.example pipeline/.env)

# --- TMDB (https://www.themoviedb.org/settings/api) ---
# Isi SALAH SATU. Disarankan: API Read Access Token (token panjang berawalan "eyJ...")
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Jeda minimal antar request (detik). Jangan dikecilkan terlalu jauh.
TMDB_MIN_INTERVAL=0.12

# --- MariaDB (harus sama dengan .env di root proyek) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=cinelog
DB_USERNAME=cinelog
DB_PASSWORD=ganti_password_db
